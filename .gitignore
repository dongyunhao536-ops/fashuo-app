# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# standalone 部署产物（云端构建推来，ECS 上的 /opt/fashuo-app/{releases,current}）
/releases/
/current

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 模板无真实密钥，且灾备手册依赖它重建 .env.local——必须进 git
!.env.local.example

# 电脑端错题复盘的本地待同步缓冲（说"同步"才落库到系统，见 scripts/cuoti.mjs）
/.local/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

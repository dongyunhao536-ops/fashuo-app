# nginx 反代配置：监听 8443 TLS（避开阿里云对 80/443 的备案要求），分两路：
#   /rest/v1/* → PostgREST 127.0.0.1:3001（路径前缀去掉 /rest/v1）
#   /*         → Next.js   127.0.0.1:3000
#
# PostgREST 对公网保留给 PC 脚本，但数据库已撤销 anon 的全部权限；只有 service_role JWT 可访问。
# 占位符：<ECS-IP> 部署时 sed 替换。
# 安装：cp nginx-fashuo.conf.tmpl /etc/nginx/sites-available/fashuo
#       sed -i "s/<ECS-IP>/<真实IP>/g" /etc/nginx/sites-available/fashuo
#       ln -sf /etc/nginx/sites-available/fashuo /etc/nginx/sites-enabled/
#       nginx -t && systemctl reload nginx

# 单 IP 登录限流：持续 5 次/分钟，允许短时 burst 5；防公开 IP 被暴力枚举口令。
limit_req_zone $binary_remote_addr zone=fashuo_login:10m rate=5r/m;

server {
    # ECS 当前为 nginx 1.18：HTTP/2 参数必须写在 listen 上（不支持新版 `http2 on;`）。
    listen 8443 ssl http2;
    listen [::]:8443 ssl http2;
    server_name <ECS-IP>;

    ssl_certificate     /etc/ssl/fashuo/cert.pem;
    ssl_certificate_key /etc/ssl/fashuo/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;

    # 七牛云 RPM 慢 + 案例题答疑可达 2.5 分钟 → 把超时拉到 5 分钟
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    send_timeout 300s;
    client_max_body_size 16m;

    # 自签 CA 公钥下载（新设备安装信任用；公钥可公开，需绕过 Next 登录）。
    location = /fashuo-ca.crt {
        alias /opt/fashuo-ca.crt;
        default_type application/x-x509-ca-cert;
    }

    # PostgREST 路由（supabase-js 默认路径 /rest/v1/<table>）
    location /rest/v1/ {
        # [gpt] 2026-08-20：用 proxy_pass 尾斜杠稳定剥离 /rest/v1/，避免安全更新改变 rewrite 捕获行为后全表 404。
        # /rest/v1/foo → /foo；不要改回依赖正则捕获的 rewrite。
        proxy_pass http://127.0.0.1:3001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /api/login {
        limit_req zone=fashuo_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # 其余全转 Next.js
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# 可选：把 80 直接 301 到 8443，但阿里云 80 对未备案 IP 有屏蔽风险，
# 推荐**完全不开 80**，iPhone 直接走 https://<IP>:8443

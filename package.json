{
  "name": "fashuo-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "node --env-file=.env.local scripts/sync-content.mjs",
    "register": "node --env-file=.env.local scripts/register-events.mjs",
    "register:full": "node --env-file=.env.local scripts/register-full.mjs",
    "fenzhang": "node scripts/fenzhang.mjs",
    "cost": "node --env-file=.env.local scripts/cost-report.mjs",
    "verify-schema": "node --env-file=.env.local scripts/verify-schema.mjs",
    "data-health": "node --env-file=.env.local scripts/data-health.mjs",
    "flow:check": "node --env-file=.env.local scripts/learning-flow-monitor.mjs check",
    "flow:weekly": "node --env-file=.env.local scripts/learning-flow-monitor.mjs weekly",
    "skill:check": "node scripts/skill-run.mjs check --days 2",
    "skill:replay": "vitest run scripts/lib/skill-run.test.mjs scripts/lib/skill-turn-guard.test.mjs scripts/lib/skill-regression-replay.test.mjs",
    "knowledge": "node --env-file=.env.local scripts/knowledge.mjs",
    "forecast": "node scripts/forecast.mjs",
    "backup:continuity": "node scripts/backup-memory.mjs",
    "backup:install-macos": "node scripts/install-continuity-backup-launchd.mjs",
    "migration:plan": "node scripts/migration-audit.mjs plan",
    "migration:snapshot": "node scripts/migration-audit.mjs snapshot",
    "migration:verify": "node scripts/migration-audit.mjs verify",
    "migration:selfhosted": "node --env-file=.env.local scripts/apply-selfhosted-migration.mjs",
    "dev:tls": "node --import=./scripts/lib/trust-fashuo-ca.mjs ./node_modules/next/dist/bin/next dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.101.0",
    "@supabase/supabase-js": "^2.107.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}

# 复制为 .env.local 并填入真实值（.env.local 已被 .gitignore 忽略，不会提交）

# Claude API（必须单独充值 API 额度；Pro 账号不可代替——00 决策表）
ANTHROPIC_API_KEY=sk-ant-...

# Supabase（B 运行状态 + C 待办筐 + A 内容镜像）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 若 Supabase URL 指向 ECS 8443 自签反代（当前架构就是）：挂自签 CA 走严格 TLS 校验。
# CA 源在 ECS /opt/fashuo-ca.crt，本地副本放 .local/fashuo-ca.crt（随每日备份）。
# 注意不能用 NODE_EXTRA_CA_CERTS（Node 启动时从系统环境读，--env-file 里设不生效）。
NODE_OPTIONS=--import=file:///D:/fashuo-app/scripts/lib/trust-fashuo-ca.mjs

# 单用户登录密码（鉴权从简，不搞 OAuth——技术栈表）
APP_PASSWORD=change-me

# 日熔断（美元/日）——10 成本模型要求必设
DAILY_BUDGET_USD=5

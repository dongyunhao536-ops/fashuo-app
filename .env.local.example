# [gpt] 2026-08-23：复制为 .env.local 后填入真实值；该文件只放模板，禁止写真实密钥。

# Windows/macOS 工作区根。留空时应用根按脚本位置推导，档案根默认取应用同级 fashuo。
# Windows 示例：FASHUO_APP_ROOT=D:/fashuo-app
# macOS 示例：FASHUO_APP_ROOT=/Users/<用户名>/Projects/fashuo-app
FASHUO_APP_ROOT=
# Windows 示例：FASHUO_ARCHIVE_ROOT=D:/fashuo
# macOS 示例：FASHUO_ARCHIVE_ROOT=/Users/<用户名>/Documents/fashuo
FASHUO_ARCHIVE_ROOT=
# 旧变量 ARCHIVE_DIR 继续兼容；新配置统一优先使用 FASHUO_ARCHIVE_ROOT。

# 七牛云 LLM 兼容接口
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/anthropic
MODEL_ASK=deepseek-v4-pro
MODEL_PLAN=deepseek-v4-pro
MODEL_COACH=deepseek-v4-pro

# Supabase（B 运行状态 + C 待办筐 + A 内容镜像）
SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 自建 Postgres 精确迁移脚本可选覆盖；不填时从 SUPABASE_URL 取主机并使用 root@<host> / fashuo。
SELFHOSTED_SSH_TARGET=root@<ECS-IP>
SELFHOSTED_DB_NAME=fashuo

# 若 Supabase URL 指向 ECS 8443 自签反代：挂自签 CA，保持严格 TLS 校验。
# CA 副本在 .local/fashuo-ca.crt。NODE_OPTIONS 必须在启动 Node 前由 shell/系统环境设置；
# 不要把它写在本文件里指望 node --env-file 生效，也不要关闭 TLS 校验。
# Windows PowerShell：$env:NODE_OPTIONS='--import=file:///D:/fashuo-app/scripts/lib/trust-fashuo-ca.mjs'
# macOS zsh：export NODE_OPTIONS='--import=file:///Users/<用户名>/Projects/fashuo-app/scripts/lib/trust-fashuo-ca.mjs'

# 单用户登录密码（鉴权从简，不搞 OAuth）
APP_PASSWORD=change-me

# 日熔断（美元/日）
DAILY_BUDGET_USD=3
